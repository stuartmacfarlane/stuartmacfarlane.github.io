---
import Site from './Site.astro'
import Tags from '../components/Tags.astro'
import { formatDate } from '../lib/articles'

const { data, headings, topics } = Astro.props
const sections = headings.filter(({ depth }: { depth: number }) => depth === 2 || depth === 3)
---
<Site title={data.title + ' | Stuart Macfarlane'} description={data.description} topics={topics}>
  <article class="article">
    <header class="article-header">
      <h1>{data.title}{data.draft && ' (Draft)'}</h1>
      <p class="lede">{data.description}</p>
      <p class="dates">
        Published <time datetime={data.pubDate.toISOString()}>{formatDate(data.pubDate)}</time>
        {data.updatedDate && <span>Updated <time datetime={data.updatedDate.toISOString()}>{formatDate(data.updatedDate)}</time></span>}
      </p>
      <Tags tags={data.tags} />
    </header>
    {sections.length >= 4 && (
      <nav class="toc" aria-labelledby="toc-title">
        <p id="toc-title">On this page</p>
        <ul>
          {sections.map(({ slug, text, depth }: { slug: string; text: string; depth: number }) => (
            <li class:list={[{ subsection: depth === 3 }]}><a href={'#' + slug}>{text}</a></li>
          ))}
        </ul>
      </nav>
    )}
    <div class="prose"><slot /></div>
    <span class="visually-hidden" id="copy-status" role="status"></span>
  </article>
</Site>
<script>
  const status = document.querySelector('#copy-status')
  for (const button of document.querySelectorAll<HTMLButtonElement>('button[data-copy-code]')) {
    let timer: number
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(JSON.parse(button.dataset.copyCode!))
        button.textContent = 'Copied!'
        button.dataset.copyState = 'success'
        if (status) status.textContent = 'Code copied to clipboard.'
      } catch {
        button.textContent = 'Copy failed'
        delete button.dataset.copyState
        if (status) status.textContent = 'Copy failed. Select the code to copy it manually.'
      }
      window.clearTimeout(timer)
      timer = window.setTimeout(() => {
        button.textContent = 'Copy'
        delete button.dataset.copyState
        if (status) status.textContent = ''
      }, 2500)
    })
  }
</script>
