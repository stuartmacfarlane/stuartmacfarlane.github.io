---
import { render } from 'astro:content'
import Article from '../../layouts/Article.astro'
import { listArticles, listTopics } from '../../lib/articles'

export async function getStaticPaths() {
  const articles = await listArticles()
  const topics = listTopics(articles)
  return articles.map((entry) => ({ params: { id: entry.id }, props: { entry, topics } }))
}

const { entry, topics } = Astro.props
const { Content, headings } = await render(entry)
---
<Article data={entry.data} headings={headings} topics={topics}>
  <Content />
</Article>
