---
import ArticleList from '../components/ArticleList.astro'
import Site from '../layouts/Site.astro'
import { listArticles, listTopics } from '../lib/articles'

const articles = await listArticles()
---
<Site title="Stuart Macfarlane | Microsoft 365 administration" description="Practical notes on Microsoft 365 administration." topics={listTopics(articles)}>
  <h1 class="index-title">Latest articles</h1>
  <ArticleList articles={articles} />
</Site>
