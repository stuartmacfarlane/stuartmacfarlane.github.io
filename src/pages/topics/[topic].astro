---
import ArticleList from '../../components/ArticleList.astro'
import Site from '../../layouts/Site.astro'
import { listArticles, listTopics, topicSlug } from '../../lib/articles'

export async function getStaticPaths() {
  const articles = await listArticles()
  const topics = listTopics(articles)
  return topics.map(({ slug, label }) => ({
    params: { topic: slug },
    props: { topics, label, articles: articles.filter(({ data }) => data.tags.some((tag) => topicSlug(tag) === slug)) },
  }))
}

const { articles, label, topics } = Astro.props
---
<Site title={label + ' | Stuart Macfarlane'} description={'Articles about ' + label + '.'} topics={topics} activeTopic={Astro.params.topic}>
  <h1 class="index-title">{label}</h1>
  <ArticleList articles={articles} />
</Site>
